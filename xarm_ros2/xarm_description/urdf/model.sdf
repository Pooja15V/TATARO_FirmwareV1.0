<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="marker_plate_gazebo">
    <static>true</static>
    <allow_auto_disable>false</allow_auto_disable>
    
    <!-- 
      Marker Plate Model for Gazebo with ArUco ID 0
      
      ArUco Marker Specifications:
      - ID: 0
      - Dictionary: 4x4_50
      - Size: 203 x 203 mm
      - Position on plate: Center (0.00, 3.00, 0.00) mm
      - Orientation: XZ horizontal plane, Y pointing up
    -->

    <link name="marker_plate">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.001</iyy>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <!-- Visual representation with texture -->
      <visual name="plate_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <!-- Convert STEP to DAE/STL using FreeCAD -->
            <uri>model://marker_plate/meshes/PJ_MRK_-_3_3.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <!-- Material script for texture -->
            <uri>model://marker_plate/materials/scripts</uri>
            <uri>model://marker_plate/materials/textures</uri>
            <name>ArUcoMarkerMaterial</name>
          </script>
          <ambient>0.8 0.8 0.8 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>

      <!-- Collision geometry -->
      <collision name="plate_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://marker_plate/meshes/PJ_MRK_-_3_3.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- 
      Optional: Frame link for marker center (useful for vision tracking)
      This represents the exact center of the ArUco marker on the plate
    -->
    <link name="aruco_marker">
      <pose relative_to="marker_plate">0 0.003 0 0 0 0</pose>
      <inertial>
        <mass>0</mass>
        <inertia>
          <ixx>0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0</iyy>
          <iyz>0</iyz>
          <izz>0</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Joint connecting marker frame to plate -->
    <joint name="marker_joint" type="fixed">
      <child>aruco_marker</child>
      <parent>marker_plate</parent>
    </joint>

    <!-- 
      Directory Structure for Gazebo Model:
      
      marker_plate/
      ├── model.sdf          (this file)
      ├── model.config       (Gazebo model metadata)
      ├── meshes/
      │   └── PJ_MRK_-_3_3.dae
      ├── materials/
      │   ├── scripts/
      │   │   └── marker.material
      │   └── textures/
      │       └── aruco_marker_id0_500px.png
      └── README.md
      
      Setup instructions:
      1. Export STEP to DAE format using FreeCAD:
         - Open PJ_MRK_-_3_3.STEP in FreeCAD
         - File → Export As → Format: "DAE (*.dae)"
         - Save to meshes/PJ_MRK_-_3_3.dae
      
      2. Create material script (materials/scripts/marker.material):
         See marker.material.example in this directory
      
      3. Copy texture file:
         - Copy aruco_marker_id0_500px.png to materials/textures/
      
      4. Create model.config (Gazebo model metadata)
      
      5. Place entire folder in:
         ~/.gazebo/models/marker_plate/
      
      6. Reference in launch file:
         <include file="$(find gazebo_ros)/launch/empty_world.launch">
           <arg name="world_name" value="..."/>
           <arg name="paused" value="false"/>
           <arg name="use_sim_time" value="true"/>
           <arg name="gui" value="true"/>
           <arg name="headless" value="false"/>
           <arg name="debug" value="false"/>
         </include>
         
         <spawn_model cmd="$(find gazebo_ros)/scripts/spawn_model.py -sdf -model marker_plate -file $(find your_package)/models/marker_plate/model.sdf" .../>
    -->

  </model>
</sdf>
