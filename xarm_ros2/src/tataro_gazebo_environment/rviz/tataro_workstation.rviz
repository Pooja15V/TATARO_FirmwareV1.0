Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 557
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_common/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true

    - Alpha: 0.75
      Class: rviz_common/RobotModel
      Collision Margin: 0.01
      Enabled: true
      Links:
        All Links Enabled: true
        Expanded:
          - link_base
          - link1
          - link2
          - link3
          - link4
          - link5
          - link6
          - tool_changer
          - gripper_base
        Link 'gripper_base':
          Alpha: 0.75
          Show Axes: false
          Show Trail: false
          Value: true
        Link 'link1':
          Alpha: 0.75
          Show Axes: false
          Show Trail: false
          Value: true
        Link 'link2':
          Alpha: 0.75
          Show Axes: false
          Show Trail: false
          Value: true
        Link 'link3':
          Alpha: 0.75
          Show Axes: false
          Show Trail: false
          Value: true
        Link 'link4':
          Alpha: 0.75
          Show Axes: false
          Show Trail: false
          Value: true
        Link 'link5':
          Alpha: 0.75
          Show Axes: false
          Show Trail: false
          Value: true
        Link 'link6':
          Alpha: 0.75
          Show Axes: false
          Show Trail: false
          Value: true
        Link 'link_base':
          Alpha: 0.75
          Show Axes: true
          Show Trail: false
          Value: true
        Link 'tool_changer':
          Alpha: 0.75
          Show Axes: false
          Show Trail: false
          Value: true
      Name: RobotModel
      Pivot Frame: <Fixed Frame>
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true

    - Class: rviz_common/TF
      Enabled: true
      Frame Limit: 50
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        Space:
          - "."
      Update Interval: 0
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_common/PointCloud2
      Color: 255; 255; 255
      Color Transformer: ""
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: PointCloud2
      Position Transformer: ""
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Flat Squares
      Topic: /camera/depth/color/points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false

    - Class: rviz_common/Marker
      Enabled: true
      Name: Marker
      Namespaces:
        {}
      Queue Size: 100
      Topic: /visualization_marker
      Unreliable: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_common/Interact
      Hide Inactive Objects: true
    - Class: rviz_common/MoveCamera
    - Class: rviz_common/Select
    - Class: rviz_common/FocusCamera
    - Class: rviz_common/Measure
      Class: rviz_common/SetInitialPose
      Theta std deviation: 0.26179938779914946
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz_common/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz_common/PublishPoint
      Single click publishing: true
      Topic: /clicked_point
  Value: true
Window Geometry:
  Displays:
    collapsed: false
  Height: 1016
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1692
  X: 10
  Y: 10
