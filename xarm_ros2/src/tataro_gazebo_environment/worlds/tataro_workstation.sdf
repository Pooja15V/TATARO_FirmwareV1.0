<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tataro_rehabilitation_workstation">
    <!-- Physics engine configuration -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Ground plane reference -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
        </inertial>
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- REHABILITATION WORKSTATION TABLE                              -->
    <!-- ============================================================ -->
    <!--
      Square tabletop: 0.85m x 0.85m
      Table surface: z = -0.005m
      Table center: (0.335, 0.0, -0.005)
      Frame: table_frame
    -->
    <model name="workstation_table">
      <static>true</static>
      <pose>0.335 0.0 -0.0075 0 0 0</pose>

      <!-- Main tabletop -->
      <link name="table_link">
        <inertial>
          <mass>50.0</mass>
          <inertia>
            <ixx>3.542</ixx>
            <iyy>3.542</iyy>
            <izz>7.083</izz>
          </inertia>
        </inertial>

        <!-- Collision geometry - main tabletop surface -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.85 0.85 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <max_vel>0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <!-- Visual geometry - wood laminate texture -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.85 0.85 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.4 1</ambient>
            <diffuse>0.85 0.75 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 0.5</specular>
            <pbr>
              <metal>
                <albedo_map>file://media/materials/textures/wood_texture.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>

      <!-- Table frame for TF publishing -->
      <frame name="table_frame" attached_to="table_link">
        <pose>0 0 0.01 0 0 0</pose>
      </frame>

      <frame name="table_surface_frame" attached_to="table_link">
        <pose>0 0 0.01 0 0 0</pose>
      </frame>
    </model>

    <!-- ============================================================ -->
    <!-- STEEL MOUNTING PLATE                                          -->
    <!-- ============================================================ -->
    <!--
      Dimensions: 0.19m x 0.12m x 0.005m
      Bottom face (on table): z = -0.005m
      Top face (robot base): z = 0.000m
      Center: z = -0.0025m
      Position on table center
    -->
    <model name="mounting_plate">
      <static>true</static>
      <pose>0.335 0.0 -0.0075 0 0 0</pose>

      <link name="plate_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.005</ixx>
            <iyy>0.007</iyy>
            <izz>0.012</izz>
          </inertia>
        </inertial>

        <!-- Collision geometry -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.19 0.12 0.005</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- Visual geometry - dark metallic steel -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.19 0.12 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>

        <!-- Mounting holes visualization (4 corner screws) -->
        <visual name="hole_1">
          <pose>0.08 0.04 0.0025 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.004</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="hole_2">
          <pose>0.08 -0.04 0.0025 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.004</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="hole_3">
          <pose>-0.08 0.04 0.0025 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.004</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="hole_4">
          <pose>-0.08 -0.04 0.0025 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.004</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Mount plate frame -->
      <frame name="mount_plate_frame" attached_to="plate_link">
        <pose>0 0 0.0025 0 0 0</pose>
      </frame>
    </model>

    <!-- ============================================================ -->
    <!-- ARUCO FIDUCIAL MARKER                                          -->
    <!-- ============================================================ -->
    <!--
      ArUco Dict4x4, ID: 0
      Dimensions: 0.15m x 0.15m
      Position: on table surface (z = -0.005m)
      Initial position: center of table
      Orientation: parallel to XY plane, normal along +Z
    -->
    <model name="aruco_marker">
      <pose>0.335 0.0 -0.0045 0 0 0</pose>

      <link name="marker_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001875</ixx>
            <iyy>0.0001875</iyy>
            <izz>0.000375</izz>
          </inertia>
        </inertial>

        <!-- Collision geometry - thin box -->
        <collision name="marker_collision">
          <geometry>
            <box>
              <size>0.15 0.15 0.001</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.3</mu>
                <mu2>0.3</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <max_vel>0.1</max_vel>
                <min_depth>0.0001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

        <!-- Visual geometry - ArUco marker pattern (Dict 4x4, ID 0) -->
        <!-- This renders a 4x4 checkerboard pattern -->
        <visual name="marker_visual">
          <geometry>
            <box>
              <size>0.15 0.15 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>file://media/materials/textures/aruco_dict4x4_id0.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- Border outline -->
        <visual name="border">
          <pose>0 0 0.0005 0 0 0</pose>
          <geometry>
            <box>
              <size>0.152 0.152 0.0001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Marker TF frame -->
      <frame name="marker_frame" attached_to="marker_link">
        <pose>0 0 0 0 0 0</pose>
      </frame>
    </model>

    <!-- ============================================================ -->
    <!-- COORDINATE FRAME VISUALIZATION                                -->
    <!-- ============================================================ -->
    <!-- Base frame indicator at robot base -->
    <model name="base_frame_indicator">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <!-- X-axis (red) -->
        <visual name="x_axis">
          <pose>0.05 0 0 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.003</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>

        <!-- Y-axis (green) -->
        <visual name="y_axis">
          <pose>0 0.05 0 -1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.003</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>

        <!-- Z-axis (blue) -->
        <visual name="z_axis">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.003</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- SCENE LIGHTING & CAMERA                                       -->
    <!-- ============================================================ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>5 5 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.5 -1</direction>
    </light>

    <light type="point" name="work_light">
      <cast_shadows>false</cast_shadows>
      <pose>0.3 0 1 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>5</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Default Gazebo camera view -->
    <gui fullscreen="false">
      <camera>
        <pose>1.5 1.5 1.0 0 0.4 -2.3</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
