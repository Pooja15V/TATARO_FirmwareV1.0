<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tf_recorder</name>
  <version>1.0.0</version>
  <description>
    Keyboard-driven TF transform recorder for eye-in-hand hand-eye calibration.
    Records synchronised link_base→link_tcp and camera_color_optical_frame→aruco_marker_frame
    transforms on each [S] keypress and writes them to a CSV file.
  </description>
  <maintainer email="thamizpooja1514@gmail.com">Pooja</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-numpy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
