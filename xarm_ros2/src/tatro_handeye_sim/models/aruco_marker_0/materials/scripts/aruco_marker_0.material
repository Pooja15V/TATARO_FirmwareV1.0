// OGRE material for ArUco marker ID=0
// The PNG must be generated by scripts/generate_aruco_texture.py before use.
material ArUcoMarker0/Surface
{
    technique
    {
        pass
        {
            lighting off
            texture_unit
            {
                texture aruco_marker_0.png
                // Disable bilinear filtering — ArUco needs sharp edges for detection
                filtering none
                max_anisotropy 1
            }
        }
    }
}
